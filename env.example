# Copy this file and fill in your real keys
# Never commit the file with real keys

# Required — get from console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional — get from openweathermap.org (free)
# Without this the app still works but shows placeholder weather
OPENWEATHER_API_KEY=your_openweather_key_here

# Required for user sessions — any random string works
SECRET_KEY=make_up_any_long_random_string_here
